{
  "name": "trustrail-hold",
  "version": "0.2.0",
  "description": "Agents buy research briefs within approved budgets: PayPal authorization holds + evidence-based delivery checks decide capture, void, or human review.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "trustrail-mcp": "src/mcp.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "mcp": "node src/mcp.js",
    "test": "node --test test/",
    "build:pages": "node scripts/build-pages.js",
    "eval": "node eval/run.js",
    "eval:llm": "TRUSTRAIL_JUDGE=local node eval/run.js",
    "verify-proof": "node scripts/verify-proof.js",
    "sandbox:lifecycle": "node scripts/sandbox-lifecycle.js",
    "sandbox:confirm": "node scripts/sandbox-confirm.js"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.7.0"
  }
}